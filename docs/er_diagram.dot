digraph ER {
rankdir=LR; splines=true; nodesep=0.45; ranksep=1.1; fontname="Helvetica";
node [shape=plain, fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=10, color="#666666"];
labelloc=t; fontsize=20; label=<<B>Wholesale ERP: Entity-Relationship Diagram</B><BR/><FONT POINT-SIZE="11">Crow's foot: | = one, crow = many. Dashed = logical (not foreign key) link.</FONT>>;
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E8F1FB" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#2E9E5B"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="11">category_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="11">name  UNIQUE</FONT></TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6F4EA" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#2E9E5B"><FONT COLOR="white"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="product_id"><FONT POINT-SIZE="11">product_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="sku"><FONT POINT-SIZE="11">sku  UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="11">name</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="11">category_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="unit"><FONT POINT-SIZE="11">unit</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="cost_price"><FONT POINT-SIZE="11">cost_price</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="unit_price"><FONT POINT-SIZE="11">unit_price</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="stock_qty"><FONT POINT-SIZE="11">stock_qty  (trigger-only)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="reorder_level"><FONT POINT-SIZE="11">reorder_level</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="active"><FONT POINT-SIZE="11">active</FONT></TD></TR></TABLE>>];
customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FDF1E3" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#D9822B"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="customer_id"><FONT POINT-SIZE="11">customer_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="11">name</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="phone"><FONT POINT-SIZE="11">phone  UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="address"><FONT POINT-SIZE="11">address</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="credit_limit"><FONT POINT-SIZE="11">credit_limit</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="active"><FONT POINT-SIZE="11">active</FONT></TD></TR></TABLE>>];
suppliers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6F4EA" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#2E9E5B"><FONT COLOR="white"><B>suppliers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="supplier_id"><FONT POINT-SIZE="11">supplier_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="11">name</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="phone"><FONT POINT-SIZE="11">phone  UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="address"><FONT POINT-SIZE="11">address</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="active"><FONT POINT-SIZE="11">active</FONT></TD></TR></TABLE>>];
sales_orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FDF1E3" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#D9822B"><FONT COLOR="white"><B>sales_orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="order_id"><FONT POINT-SIZE="11">order_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="customer_id"><FONT POINT-SIZE="11">customer_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="order_date"><FONT POINT-SIZE="11">order_date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="11">status</FONT></TD></TR></TABLE>>];
sales_order_lines [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FDF1E3" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#D9822B"><FONT COLOR="white"><B>sales_order_lines</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="line_id"><FONT POINT-SIZE="11">line_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="order_id"><FONT POINT-SIZE="11">order_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="product_id"><FONT POINT-SIZE="11">product_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="11">quantity</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="unit_price"><FONT POINT-SIZE="11">unit_price</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="unit_cost"><FONT POINT-SIZE="11">unit_cost</FONT></TD></TR></TABLE>>];
invoices [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3E8FB" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#8E44AD"><FONT COLOR="white"><B>invoices</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="invoice_id"><FONT POINT-SIZE="11">invoice_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="order_id"><FONT POINT-SIZE="11">order_id  UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="invoice_date"><FONT POINT-SIZE="11">invoice_date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="total_amount"><FONT POINT-SIZE="11">total_amount</FONT></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3E8FB" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#8E44AD"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="payment_id"><FONT POINT-SIZE="11">payment_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="invoice_id"><FONT POINT-SIZE="11">invoice_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="payment_date"><FONT POINT-SIZE="11">payment_date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="amount"><FONT POINT-SIZE="11">amount</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="method"><FONT POINT-SIZE="11">method</FONT></TD></TR></TABLE>>];
ledger_entries [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3E8FB" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#8E44AD"><FONT COLOR="white"><B>ledger_entries</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="entry_id"><FONT POINT-SIZE="11">entry_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="entry_date"><FONT POINT-SIZE="11">entry_date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="account"><FONT POINT-SIZE="11">account</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="debit"><FONT POINT-SIZE="11">debit</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="credit"><FONT POINT-SIZE="11">credit</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="ref_type"><FONT POINT-SIZE="11">ref_type</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="ref_id"><FONT POINT-SIZE="11">ref_id   (polymorphic)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="description"><FONT POINT-SIZE="11">description</FONT></TD></TR></TABLE>>];
purchase_orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6F4EA" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#2E9E5B"><FONT COLOR="white"><B>purchase_orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="po_id"><FONT POINT-SIZE="11">po_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="supplier_id"><FONT POINT-SIZE="11">supplier_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="po_date"><FONT POINT-SIZE="11">po_date</FONT></TD></TR></TABLE>>];
purchase_order_lines [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6F4EA" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#2E9E5B"><FONT COLOR="white"><B>purchase_order_lines</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="line_id"><FONT POINT-SIZE="11">line_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="po_id"><FONT POINT-SIZE="11">po_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="product_id"><FONT POINT-SIZE="11">product_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="11">quantity</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="unit_cost"><FONT POINT-SIZE="11">unit_cost</FONT></TD></TR></TABLE>>];
stock_movements [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6F4EA" COLOR="#555555"><TR><TD COLSPAN="2" BGCOLOR="#2E9E5B"><FONT COLOR="white"><B>stock_movements</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B00020"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="movement_id"><FONT POINT-SIZE="11">movement_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="product_id"><FONT POINT-SIZE="11">product_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="movement_date"><FONT POINT-SIZE="11">movement_date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="movement_type"><FONT POINT-SIZE="11">movement_type</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="quantity_change"><FONT POINT-SIZE="11">quantity_change</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="ref_id"><FONT POINT-SIZE="11">ref_id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#1F5FBF">&nbsp;</FONT></TD><TD ALIGN="LEFT" PORT="note"><FONT POINT-SIZE="11">note</FONT></TD></TR></TABLE>>];
categories -> products [label="classifies", dir=both, arrowtail=tee, arrowhead=crow];
customers -> sales_orders [label="places", dir=both, arrowtail=tee, arrowhead=crow];
sales_orders -> sales_order_lines [label="contains", dir=both, arrowtail=tee, arrowhead=crow];
products -> sales_order_lines [label="sold as", dir=both, arrowtail=tee, arrowhead=crow];
sales_orders -> invoices [label="billed by (1:1)", dir=both, arrowtail=tee, arrowhead=tee];
invoices -> payments [label="settled by", dir=both, arrowtail=tee, arrowhead=crow];
suppliers -> purchase_orders [label="supplies", dir=both, arrowtail=tee, arrowhead=crow];
purchase_orders -> purchase_order_lines [label="contains", dir=both, arrowtail=tee, arrowhead=crow];
products -> purchase_order_lines [label="bought as", dir=both, arrowtail=tee, arrowhead=crow];
products -> stock_movements [label="stock changes via", dir=both, arrowtail=tee, arrowhead=crow];
legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#999999"><TR><TD COLSPAN="2"><B>Modules</B></TD></TR><TR><TD BGCOLOR="#D9822B" WIDTH="14"> </TD><TD ALIGN="LEFT">Sales</TD></TR><TR><TD BGCOLOR="#2E9E5B"> </TD><TD ALIGN="LEFT">Inventory &amp; Purchasing</TD></TR><TR><TD BGCOLOR="#8E44AD"> </TD><TD ALIGN="LEFT">Finance</TD></TR></TABLE>>];
ledger_note [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8E44AD" BGCOLOR="#FBF6FE"><TR><TD ALIGN="LEFT"><B>ledger_entries.ref_type + ref_id</B></TD></TR><TR><TD ALIGN="LEFT">point to the source document (logical link, not an FK):</TD></TR><TR><TD ALIGN="LEFT">SALE, SALE_CANCEL  &#8594; sales_orders</TD></TR><TR><TD ALIGN="LEFT">PAYMENT  &#8594; payments</TD></TR><TR><TD ALIGN="LEFT">PURCHASE  &#8594; purchase_orders</TD></TR><TR><TD ALIGN="LEFT">ADJUSTMENT  &#8594; stock_movements</TD></TR></TABLE>>];
ledger_entries -> ledger_note [style=dashed, color="#8E44AD", arrowhead=none];
}
